# _headers — Cabeceras de seguridad para las páginas estáticas servidas por
# Cloudflare Workers Static Assets (index.html, privacidad.html, PWA...).
# Las rutas /api/* ya llevan sus propias cabeceras desde worker.js.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
